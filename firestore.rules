rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // HELPERS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userEmail() {
      return request.auth.token.email;
    }


    // =====================================================
    // USER DATA
    // =====================================================

    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }


    // =====================================================
    // SHARES
    // =====================================================

    // Owner manages their shares.
    // Recipient can read their own share.
    match /users/{uid}/shares/{shareId} {

      allow create, update, delete: if isOwner(uid);

      allow get, list: if isOwner(uid)
        || (
          signedIn()
          && resource.data.email == userEmail()
        );
    }


    // =====================================================
    // COLLECTION-GROUP SHARES
    // =====================================================

    // Required for:
    //
    // collectionGroup(db, "shares")
    // where("email", "==", userEmail)
    //
    match /{path=**}/shares/{shareId} {

      allow get, list: if signedIn()
        && resource.data.email == userEmail();
    }


    // =====================================================
    // DEBTS
    // =====================================================

    match /users/{uid}/debts/{debtId} {

      // Owner
      allow read, write: if isOwner(uid);

      // Shared recipient
      allow get, list: if signedIn()
        && exists(
          /databases/$(database)/documents/users/$(uid)/shares/$(userEmail())
        )
        && (
          get(
            /databases/$(database)/documents/users/$(uid)/shares/$(userEmail())
          ).data.category == ""
          ||
          get(
            /databases/$(database)/documents/users/$(uid)/shares/$(userEmail())
          ).data.category == resource.data.category
        );
    }
  }
}